<mujoco model="empty_seat_room">
  <!-- 空位案例仿真场景：椅子 + 人(mocap 运动学) + 出口标记；狗由 run_sim.py 注入 -->
  <option timestep="0.005"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse=".8 .8 .8"/>
    <geom name="floor" type="plane" size="6 6 0.1" rgba=".85 .85 .88 1"/>

    <body name="chair" pos="1.6 0.9 0">
      <geom name="chair_seat" type="box" pos="0 0 .45" size=".22 .22 .025" rgba=".55 .35 .15 1"/>
      <geom name="chair_back" type="box" pos="0 .24 .75" size=".22 .02 .3" rgba=".55 .35 .15 1"/>
      <geom name="chair_leg1" type="cylinder" pos=".18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="chair_leg2" type="cylinder" pos="-.18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="chair_leg3" type="cylinder" pos=".18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="chair_leg4" type="cylinder" pos="-.18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
    </body>

    <body name="exit_marker" pos="3.5 -2.5 0">
      <geom type="cylinder" size=".2 .01" rgba="0 1 0 .35"/>
    </body>

    <body name="person" mocap="true" pos="1.6 0.9 0.85">
      <geom name="person_torso" type="capsule" fromto="0 0 -.35 0 0 .35" size=".16" rgba=".8 .4 .2 1"/>
      <geom name="person_head" type="sphere" pos="0 0 .52" size=".11" rgba=".9 .75 .55 1"/>
    </body>

    <!--DOG_INJECT-->
  </worldbody>
  <!--DOG_ACTUATORS-->
</mujoco>
