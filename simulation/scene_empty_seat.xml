<mujoco model="empty_seat_room">
  <!-- 最后十米空位案例场景：3 座位(B 上有占座包) + 主人 + 2 路人(均 mocap) + 狗注入 -->
  <option timestep="0.005"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse=".8 .8 .8"/>
    <geom name="floor" type="plane" size="6 6 0.1" rgba=".85 .85 .88 1"/>

    <body name="chair_a" pos="1.6 0.9 0">
      <geom name="a_seat" type="box" pos="0 0 .45" size=".22 .22 .025" rgba=".55 .35 .15 1"/>
      <geom name="a_back" type="box" pos="0 .24 .75" size=".22 .02 .3" rgba=".55 .35 .15 1"/>
      <geom name="a_l1" type="cylinder" pos=".18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="a_l2" type="cylinder" pos="-.18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="a_l3" type="cylinder" pos=".18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="a_l4" type="cylinder" pos="-.18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
    </body>

    <body name="chair_b" pos="2.7 1.8 0">
      <geom name="b_seat" type="box" pos="0 0 .45" size=".22 .22 .025" rgba=".5 .3 .12 1"/>
      <geom name="b_back" type="box" pos="0 .24 .75" size=".22 .02 .3" rgba=".5 .3 .12 1"/>
      <geom name="b_l1" type="cylinder" pos=".18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="b_l2" type="cylinder" pos="-.18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="b_l3" type="cylinder" pos=".18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="b_l4" type="cylinder" pos="-.18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="b_bag" type="box" pos="0 0 .58" size=".14 .1 .12" rgba=".8 .1 .1 1"/>
    </body>

    <body name="chair_c" pos="0.7 2.1 0">
      <geom name="c_seat" type="box" pos="0 0 .45" size=".22 .22 .025" rgba=".45 .3 .18 1"/>
      <geom name="c_back" type="box" pos="0 .24 .75" size=".22 .02 .3" rgba=".45 .3 .18 1"/>
      <geom name="c_l1" type="cylinder" pos=".18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="c_l2" type="cylinder" pos="-.18 .18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="c_l3" type="cylinder" pos=".18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
      <geom name="c_l4" type="cylinder" pos="-.18 -.18 .225" size=".02 .225" rgba=".3 .2 .1 1"/>
    </body>

    <body name="exit_marker" pos="3.8 -2.8 0">
      <geom type="cylinder" size=".2 .01" rgba="0 1 0 .35"/>
    </body>

    <body name="person" mocap="true" pos="1.95 1.25 0.95">
      <geom name="owner_torso" type="capsule" fromto="0 0 -.35 0 0 .35" size=".16" rgba=".8 .4 .2 1"/>
      <geom name="owner_head" type="sphere" pos="0 0 .52" size=".11" rgba=".9 .75 .55 1"/>
    </body>
    <body name="person2" mocap="true" pos="0.7 2.1 0.85">
      <geom name="p2_torso" type="capsule" fromto="0 0 -.35 0 0 .35" size=".15" rgba=".2 .5 .8 1"/>
      <geom name="p2_head" type="sphere" pos="0 0 .5" size=".105" rgba=".7 .8 .9 1"/>
    </body>
    <body name="person3" mocap="true" pos="3.4 0.4 0.95">
      <geom name="p3_torso" type="capsule" fromto="0 0 -.35 0 0 .35" size=".15" rgba=".3 .7 .4 1"/>
      <geom name="p3_head" type="sphere" pos="0 0 .5" size=".105" rgba=".7 .9 .75 1"/>
    </body>

    <!--DOG_INJECT-->
  </worldbody>
  <!--DOG_ACTUATORS-->
</mujoco>
